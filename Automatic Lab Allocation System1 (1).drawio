        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% ==========================================\n    %% ENTITIES (Green Rectangles)\n    %% ==========================================\n    USER[USER]\n    LAB[LAB]\n    WORKSTATION[WORKSTATION]\n    COURSE[COURSE]\n    TIME_SLOT[TIME_SLOT]\n    SCHEDULE[SCHEDULE]\n    AD_HOC[AD_HOC_REQUEST]\n    ISSUE[ISSUE_REPORT]\n    NOTIF[NOTIFICATION]\n\n    %% ==========================================\n    %% RELATIONSHIPS (Blue Diamonds)\n    %% ==========================================\n    R_PLACES{Places}\n    R_FILES{Files}\n    R_RECEIVES{Receives}\n    R_CONTAINS{Contains}\n    R_HOSTS{Hosts}\n    R_REQUIRES{Requires}\n    R_SPANS{Spans}\n    R_TEACHES{Teaches}\n    R_TAGGED{Tagged_In}\n    R_REQ_LAB{Requested_For}\n    R_REQ_SLOT{Booked_Slot}\n\n    %% ==========================================\n    %% ATTRIBUTES (Light Orange Ovals)\n    %% ==========================================\n    \n    %% USER Attributes\n    U_PK([&lt;u&gt;User_ID&lt;/u&gt;])\n    U_1([Name])\n    U_2([Email])\n    U_3([Password])\n    U_4([Role])\n\n    %% LAB Attributes\n    L_PK([&lt;u&gt;Lab_ID&lt;/u&gt;])\n    L_1([Lab_Name])\n    L_2([Capacity])\n    L_3([System_Count])\n    L_4([OS_Installed])\n    L_5([GPU_Capacity])\n\n    %% WORKSTATION Attributes\n    W_PK([&lt;u&gt;Workstation_ID&lt;/u&gt;])\n    W_1([Station_Number])\n    W_2([Status])\n\n    %% COURSE Attributes\n    C_PK([&lt;u&gt;Course_ID&lt;/u&gt;])\n    C_1([Course_Code])\n    C_2([Course_Name])\n    C_3([Department])\n\n    %% TIME_SLOT Attributes\n    T_PK([&lt;u&gt;Slot_ID&lt;/u&gt;])\n    T_1([Day_Of_Week])\n    T_2([Start_Time])\n    T_3([End_Time])\n\n    %% SCHEDULE Attributes\n    S_PK([&lt;u&gt;Schedule_ID&lt;/u&gt;])\n    S_1([Session_Type])\n\n    %% AD_HOC_REQUEST Attributes\n    A_PK([&lt;u&gt;Request_ID&lt;/u&gt;])\n    A_1([Request_Date])\n    A_2([Status])\n    A_3([Reason])\n\n    %% ISSUE_REPORT Attributes\n    I_PK([&lt;u&gt;Issue_ID&lt;/u&gt;])\n    I_1([Description])\n    I_2([Status])\n    I_3([Reported_At])\n\n    %% NOTIFICATION Attributes\n    N_PK([&lt;u&gt;Notification_ID&lt;/u&gt;])\n    N_1([Message])\n    N_2([Created_At])\n    N_3([Is_Read])\n\n    %% ==========================================\n    %% ENTITY TO ATTRIBUTE CONNECTIONS\n    %% ==========================================\n    USER --- U_PK\n    USER --- U_1\n    USER --- U_2\n    USER --- U_3\n    USER --- U_4\n\n    LAB --- L_PK\n    LAB --- L_1\n    LAB --- L_2\n    LAB --- L_3\n    LAB --- L_4\n    LAB --- L_5\n\n    WORKSTATION --- W_PK\n    WORKSTATION --- W_1\n    WORKSTATION --- W_2\n\n    COURSE --- C_PK\n    COURSE --- C_1\n    COURSE --- C_2\n    COURSE --- C_3\n\n    TIME_SLOT --- T_PK\n    TIME_SLOT --- T_1\n    TIME_SLOT --- T_2\n    TIME_SLOT --- T_3\n\n    SCHEDULE --- S_PK\n    SCHEDULE --- S_1\n\n    AD_HOC --- A_PK\n    AD_HOC --- A_1\n    AD_HOC --- A_2\n    AD_HOC --- A_3\n\n    ISSUE --- I_PK\n    ISSUE --- I_1\n    ISSUE --- I_2\n    ISSUE --- I_3\n\n    NOTIF --- N_PK\n    NOTIF --- N_1\n    NOTIF --- N_2\n    NOTIF --- N_3\n\n    %% ==========================================\n    %% RELATIONSHIP CONNECTIONS WITH CARDINALITIES\n    %% ==========================================\n    USER ---|1| R_PLACES\n    R_PLACES ---|n| AD_HOC\n\n    USER ---|1| R_FILES\n    R_FILES ---|n| ISSUE\n\n    USER ---|1| R_RECEIVES\n    R_RECEIVES ---|n| NOTIF\n\n    USER ---|1| R_TEACHES\n    R_TEACHES ---|n| SCHEDULE\n\n    LAB ---|1| R_CONTAINS\n    R_CONTAINS ---|n| WORKSTATION\n\n    LAB ---|1| R_HOSTS\n    R_HOSTS ---|n| SCHEDULE\n\n    LAB ---|1| R_REQ_LAB\n    R_REQ_LAB ---|n| AD_HOC\n\n    COURSE ---|1| R_REQUIRES\n    R_REQUIRES ---|n| SCHEDULE\n\n    TIME_SLOT ---|1| R_SPANS\n    R_SPANS ---|n| SCHEDULE\n\n    TIME_SLOT ---|1| R_REQ_SLOT\n    R_REQ_SLOT ---|n| AD_HOC\n\n    WORKSTATION ---|1| R_TAGGED\n    R_TAGGED ---|n| ISSUE\n\n    %% ==========================================\n    %% COLOR STYLING (PETER CHEN NOTATION)\n    %% ==========================================\n    style USER fill:#d5e8d4,stroke:#82b366,stroke-width:2px\n    style LAB fill:#d5e8d4,stroke:#82b366,stroke-width:2px\n    style WORKSTATION fill:#d5e8d4,stroke:#82b366,stroke-width:2px\n    style COURSE fill:#d5e8d4,stroke:#82b366,stroke-width:2px\n    style TIME_SLOT fill:#d5e8d4,stroke:#82b366,stroke-width:2px\n    style SCHEDULE fill:#d5e8d4,stroke:#82b366,stroke-width:2px\n    style AD_HOC fill:#d5e8d4,stroke:#82b366,stroke-width:2px\n    style ISSUE fill:#d5e8d4,stroke:#82b366,stroke-width:2px\n    style NOTIF fill:#d5e8d4,stroke:#82b366,stroke-width:2px\n\n    style R_PLACES fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px\n    style R_FILES fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px\n    style R_RECEIVES fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px\n    style R_CONTAINS fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px\n    style R_HOSTS fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px\n    style R_REQUIRES fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px\n    style R_SPANS fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px\n    style R_TEACHES fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px\n    style R_TAGGED fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px\n    style R_REQ_LAB fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px\n    style R_REQ_SLOT fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px\n\n    style U_PK fill:#ffe6cc,stroke:#d79b00,stroke-width:1px\n    style U_1 fill:#ffe6cc,stroke:#d79b00,stroke-width:1px\n    style U_2 fill:#ffe6cc,stroke:#d79b00,stroke-width:1px\n    style U_3 fill:#ffe6cc,stroke:#d79b00,stroke-width:1px\n    style U_4 fill:#ffe6cc,stroke:#d79b00,stroke-width:1px\n\n    style L_PK fill:#ffe6cc,stroke:#d79b00,stroke-width:1px\n    style L_1 fill:#ffe6cc,stroke:#d79b00,stroke-width:1px\n    style L_2 fill:#ffe6cc,stroke:#d79b00,stroke-width:1px\n    style L_3 fill:#ffe6cc,stroke:#d79b00,stroke-width:1px\n    style L_4 fill:#ffe6cc,stroke:#d79b00,stroke-width:1px\n    style L_